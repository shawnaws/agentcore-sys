#!/bin/bash

# Git hook to auto-generate commit message from .scratch file
# This runs automatically when you do 'git commit' (without -m flag)

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# Only run if this is a new commit (not amend, merge, etc.)
if [ -z "$COMMIT_SOURCE" ]; then
    SCRATCH_FILE="../.scratch"
    
    if [ -f "$SCRATCH_FILE" ]; then
        echo "📝 Generating commit message from .scratch..."
        
        q chat --trust-all-tools --no-interactive "Read the .scratch file containing granular change notes. Synthesize these into a professional git commit message that: 1. Starts with a conventional commit prefix (feat/fix/refactor/chore/docs) 2. Summarizes the main change in under 50 characters 3. Adds a body with 2-4 bullet points for key details 4. Focuses on WHAT changed, not implementation details Output only the commit message, ready to use. Send the output to the appropriate $COMMIT_MSG_FILE"
    fi
fi
